<?xml version="1.0" encoding="utf-8"?>
<xar:template xmlns:xar="http://xaraya.com/2004/blocklayout">
    <xar:if condition="$tabmodule ne 'categories'">
        <xar:set name="regid">$xar->mod()->getRegID($tabmodule)</xar:set>
    <xar:else />
        <xar:set name="regid">0</xar:set>
    </xar:if>
    <div class="xar-row">
        <div class="xar-col">
            <label for="items_per_page" title="#$xar->ml('Object to use to model a category')#" class="xar-form-label">
                Categories object:
            </label>
        </div>
        <div class="xar-col">
            <xar:set name="value"><xar:var scope="module" module="categories" name="categoriesobject"/></xar:set>
            <xar:data-input type="object" name="categoriesobject" value="$value" store_prop="name"/>
        </div>
    </div>
    <div class="xar-row">
        <div class="xar-col">
            <label for="bar" title="#$xar->ml('The categories can be navigated in an explorer style interface.')#" class="xar-form-label">
                Windows Explorer style tree
            </label>
        </div>
        <div class="xar-col">
            <xar:set name="checked">$xar->mod('categories')->getItemVar('usejsdisplay', $regid)</xar:set>
            <xar:data-input type="checkbox" name="usejsdisplay" checked="$checked"/>
        </div>
    </div>
    <div class="xar-row">
        <div class="xar-col">
            <label for="bar" title="#$xar->ml('Specify how many links you want to see per page.')#" class="xar-form-label">
                Links shown in statistics            
            </label>
        </div>
        <div class="xar-col">
            <xar:set name="value">$xar->mod('categories')->getItemVar('numstats', $regid)</xar:set>
            <input type="text" name="numstats" id="numstats" value="#$value#"/>
        </div>
    </div>
    <div class="xar-row">
        <div class="xar-col">
            <label for="bar" title="#$xar->ml('In many cases, you can see the item title if you want.')#" class="xar-form-label">
                Show the item title in statistics
            </label>
        </div>
        <div class="xar-col">
            <xar:set name="checked">$xar->mod('categories')->getItemVar('showtitle', $regid)</xar:set>
            <xar:data-input type="checkbox" name="showtitle" checked="$checked"/>
        </div>
    </div>
    <div class="xar-row">
        <div class="xar-col">
            <label for="bar" title="#$xar->ml('Make the batch processing option visible')#" class="xar-form-label">
                Allow batch processing
            </label>
        </div>
        <div class="xar-col">
            <xar:set name="checked">$xar->mod('categories')->getItemVar('allowbatch', $regid)</xar:set>
            <xar:data-input type="checkbox" name="allowbatch" checked="$checked"/>
        </div>
    </div>
</xar:template>