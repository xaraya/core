<?xml version="1.0" encoding="utf-8"?>
<xar:template xmlns:xar="http://xaraya.com/2004/blocklayout">
    <!-- License: GPL http://www.gnu.org/copyleft/gpl.html -->
    <xar:comment><xar:template file="user-mod-head"/></xar:comment>
    <div class="xar-mod-body">

        <h2>Class Map</h2>
        <p>This page allows you to explore the autoload class map for Xaraya modules</p>
        <xar:set name="classmap">xarClassMap::getClassMap()</xar:set>
        <xar:set name="dummy">$xar->var()->find('class', $class)</xar:set>
        <xar:set name="dummy">$xar->var()->find('mod', $mod)</xar:set>

        <xar:if condition="empty($class) and !empty($mod)">
            <strong>#$mod#:</strong>
        </xar:if>
        <ul>
        <xar:foreach in="$classmap" key="$classtype" value="$values">
            <li>
                <xar:set name="url">$xar->ctl()->getCurrentURL(['class' => $classtype, 'mod' => null])</xar:set>
                <xar:if condition="!empty($class) and $class eq $classtype">
                    <a href="#$url#">#$classtype#</a>:
                    <ul>
                    <xar:foreach in="$values" key="$module" value="$types">
                        <xar:set name="url">$xar->ctl()->getCurrentURL(['class' => $classtype, 'mod' => $module])</xar:set>
                        <xar:if condition="is_array($types)">
                            <li>
                                <xar:if condition="isset($mod) and $mod eq $module">
                                    #$module# (#count($types)#):
                                    <ul>
                                    <xar:foreach in="$types" key="$type" value="$items">
                                        <li>
                                            <xar:if condition="$classtype eq 'methods'">
                                                #$type# (#count($items)#)
                                            <xar:else/>
                                                #$type# =&gt; #implode(', ', array_keys($items))#
                                            </xar:if>
                                        </li>
                                    </xar:foreach>
                                    </ul>
                                <xar:else/>
                                    <a href="#$url#">#$module#&#160;</a> (#count($types)#)
                                </xar:if>
                            </li>
                        <xar:else/>
                            <li>
                                <xar:if condition="isset($mod) and $mod eq $module">
                                    #$module#:
                                    #basename($types)#
                                <xar:else/>
                                    <a href="#$url#">#$module#</a>
                                </xar:if>
                            </li>
                        </xar:if>
                    </xar:foreach>
                    </ul>
                <xar:elseif condition="empty($class) and !empty($mod)"/>
                    <xar:if condition="empty($values[$mod])">
                        <a href="#$url#">#$classtype#</a> (0):
                    <xar:else/>
                        <a href="#$url#">#$classtype#</a> (#count($values[$mod])#):
                        <ul>
                        <xar:foreach in="$values[$mod]" key="$type" value="$items">
                            <li>
                                <xar:if condition="$classtype eq 'methods'">
                                    #$type# (#count($items)#)
                                <xar:else/>
                                    #$type# =&gt; #implode(', ', array_keys($items))#
                                </xar:if>
                            </li>
                        </xar:foreach>
                        </ul>
                    </xar:if>
                <xar:else/>
                    <a href="#$url#">#$classtype#</a>
                </xar:if>
            </li>
        </xar:foreach>
        </ul>
    </div>

</xar:template>