<?xml version="1.0" encoding="utf-8"?>
<xar:template xmlns:xar="http://xaraya.com/2004/blocklayout">
    <xar:if condition="isset($error_message)">
        <xar:else />
        <xar:loop name="$items">
            <item>
                <title>#$xar->prep()->text($loop:item['Subject'])#</title>
                <link>#$xar->ctl()->URL('newsgroups', 'user', 'article', ['group' => $group, 'article' => $loop:item['number']])#</link>
                <description></description>
                <author>#$xar->prep()->email($xar->prep()->text($loop:item['From']))#</author>
                <pubDate>#$xar->mls()->formatUTCDate("%a, %d %b %Y %H:%M:%S
                GMT",strtotime($loop:item['Date']))#</pubDate>
            </item>
        </xar:loop>
    </xar:if>
</xar:template>